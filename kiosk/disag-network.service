[Unit]
Description=DISAG network configuration from boot partition
DefaultDependencies=no
After=local-fs.target
Before=NetworkManager.service network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/disag-network
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
